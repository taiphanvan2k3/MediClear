# ==========================================
# Google Gemini AI Configuration
# ==========================================
# GEMINI_API_KEY: Required for Gemini Vision OCR & Medical Intelligence
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional Gemini Model Overrides
# GEMINI_PRIMARY_GROUNDING_MODEL="gemini-3.5-flash-lite"
# GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# ==========================================
# Medical Search Engine (Tavily Grounding)
# ==========================================
# TAVILY_API_KEY: Required for real-time medical web search & live clinical citations
# Get your free API key at: https://tavily.com/
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# ==========================================
# Server & Environment Configuration
# ==========================================
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ==========================================
# Google Firebase Configuration (Client-side)
# ==========================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
